# Supabase project credentials. Copy to .env and fill in real values.
# DO NOT commit a real .env.

# Supabase API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Database (transaction pooler URL is preferred for serverless)
DATABASE_URL=postgres://postgres:<password>@<host>:6543/postgres

# Edge Function secrets (also set in Supabase dashboard)
SUPABASE_FUNCTIONS_LOCAL=true
